{
  "name": "SiTA",
  "version": "0.0.1",
  "description": "SiTA (Simple Typing Assistant) is an open-source tool designed to help users learn and practice 10-finger typing skills.",
  "license": "MIT",
  "author": "Martin Großer",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && cpx src/index.html dist/ && cpx src/styles/**/* dist/styles/",
    "build-dist": "electron-builder --win"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "homepage": "https://github.com/mgrosser3/sita#readme",
  "bugs": {
    "url": "https://github.com/mgrosser3/sita/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgrosser3/sita.git"
  },
  "devDependencies": {
    "cpx": "^1.5.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "org.mgrosser3.sita",
    "productName": "SiTA",
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
